# ==============================================================================
# RGUKT Ongole Placement Hub - Environment Configuration Template
# ==============================================================================

# ── API Gateway & Edge ─────────────────────────────────────────────────────────
GATEWAY_PORT=8080
CLIENT_PORT=5173

# ── Security & Authentication ─────────────────────────────────────────────────
SERVICE_API_KEY=replace-with-a-unique-random-service-key
JWT_SECRET=replace-with-a-unique-random-jwt-secret
JWT_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=604800

# ── Database URIs (Docker Compose Internal Network) ───────────────────────────
AUTH_DB_URI=mongodb://auth-db:27017/rgukt_auth_db
STUDENT_DB_URI=mongodb://student-db:27017/rgukt_student_db
DRIVE_DB_URI=mongodb://drive-db:27017/rgukt_drive_db
APPLICATION_DB_URI=mongodb://application-db:27017/rgukt_application_db
NOTIFICATION_DB_URI=mongodb://notification-db:27017/rgukt_notification_db

# ── Database URIs (Local Dev / Native Node outside Docker) ───────────────────
LOCAL_AUTH_DB_URI=mongodb://127.0.0.1:27017/rgukt_auth_db
LOCAL_STUDENT_DB_URI=mongodb://127.0.0.1:27017/rgukt_student_db
LOCAL_DRIVE_DB_URI=mongodb://127.0.0.1:27017/rgukt_drive_db
LOCAL_APPLICATION_DB_URI=mongodb://127.0.0.1:27017/rgukt_application_db
LOCAL_NOTIFICATION_DB_URI=mongodb://127.0.0.1:27017/rgukt_notification_db

# ── Message Broker ────────────────────────────────────────────────────────────
RABBITMQ_USER=replace-with-random-user
RABBITMQ_PASSWORD=replace-with-random-alphanumeric-password
LOCAL_RABBITMQ_URI=amqp://guest:guest@localhost:5672

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development

